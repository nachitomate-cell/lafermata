rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function userDoc() {
      return /databases/$(database)/documents/fermata_usuarios/$(request.auth.uid);
    }
    function isStaff() {
      return isSignedIn() && exists(userDoc()) && get(userDoc()).data.rol == "staff";
    }

    // ── Usuarios del Club ──────────────────────────────────────────────────────
    match /fermata_usuarios/{userId} {
      allow get:    if isSignedIn();
      allow list:   if isStaff();
      allow create: if isOwner(userId)
                    && request.resource.data.rol == "cliente"
                    && request.resource.data.sellos == 1;
      allow update: if isOwner(userId) || isStaff();
      allow delete: if isStaff();
    }

    // ── Premios (catálogo) ─────────────────────────────────────────────────────
    match /fermata_premios/{premioId} {
      allow read:                   if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // ── Canjes ────────────────────────────────────────────────────────────────
    match /fermata_canjes/{canjeId} {
      allow create: if isSignedIn()
                    && request.resource.data.clienteId == request.auth.uid;
      allow read:   if isSignedIn()
                    && (resource.data.clienteId == request.auth.uid || isStaff());
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // ── Pending Stamps (Handshake Digital) ────────────────────────────────────
    match /fermata_pending_stamps/{stampId} {
      allow read:   if isSignedIn()
                    && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isSignedIn();
      allow update: if isStaff()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn()
                    && (resource.data.userId == request.auth.uid || isStaff());
    }

    // ── Logs del sistema ──────────────────────────────────────────────────────
    match /fermata_logs/{logId} {
      allow read:         if isStaff()
                          || (isSignedIn() && resource.data.usuarioId == request.auth.uid);
      allow create:       if isSignedIn();
      allow update, delete: if false;
    }

    // ── Reservas ──────────────────────────────────────────────────────────────
    // Clients create their own; any signed-in user (staff) can read and manage.
    match /fermata_reservas/{reservaId} {
      allow read, create, update: if isSignedIn();
      allow delete:               if isStaff();
    }

    // ── Pedidos (WebPay / takeaway) ───────────────────────────────────────────
    // Clients create before redirect; client and kitchen read/update status.
    match /fermata_pedidos/{pedidoId} {
      allow read, create, update: if isSignedIn();
      allow delete:               if isStaff();
    }

    // ── Mesas ─────────────────────────────────────────────────────────────────
    // Staff-only UI, but any authenticated user can read/write (PIN gates the UI).
    match /fermata_mesas/{mesaId} {
      allow read, write: if isSignedIn();
    }

    // ── Chat de pedidos ───────────────────────────────────────────────────────
    // Any authenticated user (incl. anonymous) can send and read messages.
    // Messages are immutable once created; only staff can delete.
    match /fermata_chats/{orderId}/messages/{messageId} {
      allow read, create: if isSignedIn();
      allow update:       if false;
      allow delete:       if isStaff();
    }

  }
}
